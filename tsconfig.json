{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2024"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "lib/types",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [
    "src/session.ts",
    "src/registry.ts",
    "src/contract.ts",
    "src/send-text.ts",
    "src/host-files.ts",
    "src/host-persist.ts",
    "src/host-rpc.ts",
    "src/review.ts",
    "src/browser.ts",
    "src/terminal.ts",
    "src/side-chat.ts",
    "src/index.ts"
  ]
}
